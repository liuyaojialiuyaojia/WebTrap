# Copy this file to .env and fill in values for your own runtime.

# Model API credentials. The code uses the OpenAI-compatible chat API.
OPENAI_API_KEY=

# Optional: set this when using a custom OpenAI-compatible endpoint.
# Example: https://api.example.com/v1
OPENAI_BASE_URL=
OPENAI_API_BASE=

# Optional: forward cache controls through extra_body.cache for compatible gateways.
WEBTRAP_ENABLE_CACHE_BODY=0

# Optional proxy settings for provider access.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
